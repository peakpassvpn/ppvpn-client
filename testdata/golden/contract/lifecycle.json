{
  "name": "lifecycle",
  "description": "Lifecycle: start before any profile, apply, start, status, stop twice. Platform with no local proxy and no TUN, so nothing listens. The profile replaces the REALITY ingress (which needs the with_utls build tag) so the outcome is the same under every tag set.",
  "steps": [
    {
      "name": "start_without_profile",
      "method": "start",
      "body": {}
    },
    {
      "name": "status_stopped",
      "method": "get-status",
      "body": {}
    },
    {
      "name": "apply",
      "method": "apply-profile",
      "body": {},
      "profile_ref": {
        "base": "profiles/base.json",
        "patch": [
          {
            "op": "replace",
            "path": "/nodes/0/ingresses/0/protocol",
            "value": "shadowsocks"
          },
          {
            "op": "replace",
            "path": "/nodes/0/ingresses/0/credentials",
            "value": {
              "shadowsocks": {
                "method": "2022-blake3-aes-128-gcm",
                "user_key": "AAAAAAAAAAAAAAAAAAAAAA=="
              }
            }
          },
          {
            "op": "remove",
            "path": "/nodes/0/ingresses/0/tls"
          }
        ]
      }
    },
    {
      "name": "status_configured",
      "method": "get-status",
      "body": {}
    },
    {
      "name": "start",
      "method": "start",
      "body": {}
    },
    {
      "name": "status_running",
      "method": "get-status",
      "body": {}
    },
    {
      "name": "start_again",
      "method": "start",
      "body": {}
    },
    {
      "name": "stop",
      "method": "stop",
      "body": {}
    },
    {
      "name": "status_after_stop",
      "method": "get-status",
      "body": {}
    },
    {
      "name": "stop_again",
      "method": "stop",
      "body": {}
    },
    {
      "name": "probe_availability_local_proxy_disabled",
      "method": "probe-availability",
      "body": {
        "node_id": "3f2c9a1e-0000-4000-8000-000000000001-128",
        "target": "https://example.com/",
        "timeout_ms": 1000
      }
    }
  ],
