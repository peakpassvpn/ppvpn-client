        "routing_mode": "rules"
      },
      "profile_ref": {
        "base": "profiles/base.json",
        "patch": [
          {
            "op": "replace",
            "path": "/revision",
            "value": "2026-09-29T00:00:00Z#2"
          }
        ]
      }
    },
    {
      "name": "status_r2",
      "method": "get-status",
      "body": {}
    },
    {
      "name": "apply_unknown_default_node_keeps_selection",
