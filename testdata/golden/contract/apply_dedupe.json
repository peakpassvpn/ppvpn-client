      "name": "apply_r1",
      "method": "apply-profile",
      "body": {},
      "profile_ref": {
        "base": "profiles/base.json"
      }
    },
    {
      "name": "apply_r1_again",
      "method": "apply-profile",
      "body": {},
      "profile_ref": {
        "base": "profiles/base.json"
      }
    },
    {
      "name": "apply_r1_global",
      "method": "apply-profile",
      "body": {
        "routing_mode": "global"
      },
      "profile_ref": {
        "base": "profiles/base.json"
      }
    },
    {
      "name": "status_global",
      "method": "get-status",
      "body": {}
    },
    {
