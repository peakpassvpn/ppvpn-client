# Sourced by the host-side scripts (lab.sh, up.sh, t3-host.sh, t4-host.sh,
# repro/run-all.sh). Every name and limit is a parameter: the defaults run
# the lab on a laptop; a shared host sets its own prefix and CPU set.
#
#   LAB_PREFIX      containers <prefix>-client, -web, -a, -b, -c, -dns,
#                   -dns-node (default "lab")
#   LAB_NETWORK     the internal docker network (default <prefix>-net)
#   LAB_IMAGE       the image tag (default <prefix>-image)
#   LAB_CPUSET      docker --cpuset-cpus for every container and the image
#                   build, e.g. the CPUs a job queue granted (default unset)
#   LAB_MEMORY      docker --memory per container (default unset)
#   LAB_APK_MIRROR  Alpine mirror for the image build, e.g.
#                   https://mirrors.example.org (default dl-cdn.alpinelinux.org)
#   LAB_WORK        the work directory: keys, configs, binaries, logs
#                   (default ./work)
LAB=${LAB_PREFIX:-lab}
LAB_NETWORK=${LAB_NETWORK:-$LAB-net}
LAB_IMAGE=${LAB_IMAGE:-$LAB-image}
LAB_WORK=${LAB_WORK:-$PWD/work}
LAB_RUN_OPTS="${LAB_CPUSET:+--cpuset-cpus $LAB_CPUSET} ${LAB_MEMORY:+--memory $LAB_MEMORY}"
export LAB LAB_NETWORK LAB_IMAGE LAB_WORK LAB_RUN_OPTS LAB_CPUSET LAB_MEMORY
