<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkle-format appcast for PPVPN on Windows, as read by WinSparkle 0.9.x.
  From 0.6.0 on the app reads it from the update site,
    https://pkg.peakpassvpn.com/desktop/stable/appcast-windows-x64.xml
  which tools/desktop/ci/update_site.py writes from
  dist/windows/release-meta-windows-x64.json (apps/windows/scripts/package.ps1
  writes it next to the installer):

    release-meta field      appcast
    ─────────────────────   ──────────────────────────────────────────────
    version                 sparkle:shortVersionString  (shown to the user)
    build                   sparkle:version             (compared by WinSparkle;
                                                         the app's FileVersion)
    file                    the enclosure url's last part
    length                  enclosure length            (bytes)
    ed_signature            enclosure sparkle:edSignature (EdDSA/ed25519 over the
                                                         installer bytes, base64)
    min_os                  sparkle:minimumSystemVersion
    installer_arguments     enclosure sparkle:installerArguments ("/S": silent install)
    platform                enclosure sparkle:os        ("windows-x64")
    published_at            pubDate                     (RFC 822 in the feed)
    sha256                  not in the feed; the site checks the installer with it

  The enclosure is the installer's copy on the update site,
  desktop/stable/<version>/<build>/<file> (docs/release.md, "更新站点"). WinSparkle
  verifies sparkle:edSignature against the downloaded bytes with the public key
  compiled into the app (PPVPN_UPDATE_PUBLIC_KEY); an enclosure with a missing or
  wrong signature is rejected and nothing is run. The feed has one item, the
  release the channel points at; sparkle:releaseNotesLink is the GitHub Release.

  Apps before 0.6.0 read the backend's legacy feed,
  https://www.peakpassvpn.com/api/v1/desktop/releases/windows-x64/appcast.xml,
  rendered from the same release-meta (the pointer in the private bucket,
  tools/desktop/ci/upload-downloads.sh). Its enclosure is the backend's
  /api/v1/desktop/native/releases/windows-x64/update, which always serves the
  release-meta's file (on macOS the DMG, never the first-install .pkg).
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>PPVPN for Windows</title>
    <link>https://www.peakpassvpn.com</link>
    <item>
      <title>PPVPN 0.6.1</title>
      <pubDate>Thu, 15 Oct 2026 01:52:10 +0000</pubDate>
      <sparkle:version>0.6.1.165</sparkle:version>
      <sparkle:shortVersionString>0.6.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>10.0.17763</sparkle:minimumSystemVersion>
      <sparkle:releaseNotesLink>https://github.com/peakpassvpn/ppvpn-client/releases/tag/v0.6.1</sparkle:releaseNotesLink>
      <enclosure
        url="https://pkg.peakpassvpn.com/desktop/stable/0.6.1/165/PPVPN-0.6.1-windows-x64-setup.exe"
        sparkle:os="windows-x64"
        sparkle:installerArguments="/S"
        length="78135228"
        type="application/octet-stream"
        sparkle:edSignature="BASE64_ED25519_SIGNATURE_OF_THE_INSTALLER" />
    </item>
  </channel>
</rss>
