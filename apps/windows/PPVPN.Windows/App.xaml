<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PPVPN.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F1F4390" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F16A34A" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#21D97706" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#BA1A1A" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1ABA1A1A" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#BA1A1A" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FlagRingBrush" Color="#1F000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#29B4C5FF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#294ADE80" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFB59D" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#29FFB59D" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FFB4AB" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#29FFB4AB" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#FFB4AB" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#690005" />
                    <SolidColorBrush x:Key="FlagRingBrush" Color="#33FFFFFF" />
                    <!-- on-accent text is dark blue on the light accent. -->
                    <Color x:Key="TextOnAccentFillColorPrimary">#002A78</Color>
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#002A78" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
              Brand accent (design tokens): the whole SystemAccentColor ramp. Light theme controls use
              SystemAccentColorDark1 (#1f4390), dark theme SystemAccentColorLight2 (#b4c5ff).
            -->
            <Color x:Key="SystemAccentColor">#2F55A8</Color>
            <Color x:Key="SystemAccentColorDark1">#1F4390</Color>
            <Color x:Key="SystemAccentColorDark2">#183572</Color>
            <Color x:Key="SystemAccentColorDark3">#102552</Color>
            <Color x:Key="SystemAccentColorLight1">#7C95D6</Color>
            <Color x:Key="SystemAccentColorLight2">#B4C5FF</Color>
            <Color x:Key="SystemAccentColorLight3">#DBE1FF</Color>

            <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>
            <!-- Content padding 24 × 32 (top 24, sides 32, bottom 32). -->
            <Thickness x:Key="PageContentPadding">32,24,32,32</Thickness>
            <Thickness x:Key="ToolPagePadding">32,16,32,16</Thickness>
            <x:Double x:Key="PageMaxWidth">1000</x:Double>
            <CornerRadius x:Key="CardRadius">8</CornerRadius>

            <!-- Settings page title: 28 Semibold. -->
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- Group header: 600, margin 24/0/4. -->
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="1,24,0,8" />
            </Style>

            <!-- Row description: 12, the weakest text colour. -->
            <Style x:Key="RowDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Borderless button (WinUI 3 has no built-in subtle style). -->
            <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="8,6,8,6" />
            </Style>

            <!-- A card: system card surface, radius 8. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            </Style>

            <!-- Divider between rows inside a card. -->
            <Style x:Key="RowDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!-- Unread badge: danger pill with a ring in the background colour; text ("3", "99+") from Tag. -->
            <Style x:Key="TextInfoBadgeStyle" TargetType="InfoBadge">
                <Setter Property="Background" Value="{ThemeResource BadgeBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource BadgeTextBrush}" />
                <Setter Property="MinWidth" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="InfoBadge">
                            <Border
                                MinWidth="{TemplateBinding MinWidth}"
                                Height="{TemplateBinding Height}"
                                Padding="4,0,4,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderThickness="1.5"
                                CornerRadius="9">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented choice built from RadioButtons: 28 high, 13px, selected = fill + 14×3 accent pill. -->
            <Style x:Key="SegmentStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid
                                x:Name="RootGrid"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                                                <Setter Target="Pill.Opacity" Value="1" />
                                                <Setter Target="Label.FontWeight" Value="SemiBold" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    x:Name="Label"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <Border
                                    x:Name="Pill"
                                    Width="14"
                                    Height="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5"
                                    Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
