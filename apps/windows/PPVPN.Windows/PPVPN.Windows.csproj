<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PPVPN.Windows</RootNamespace>
    <!-- ppvpn-service only accepts clients named ppvpn.exe running from its install directory. -->
    <AssemblyName>ppvpn</AssemblyName>
    <!-- Version, Product and Company: ../Directory.Build.props. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs owns Main so single-instance redirection runs before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Ship only the UI languages the app has (satellite assemblies); package.ps1 also prunes
         the Windows App SDK's *.mui language folders. -->
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Backend base URL (ClientConfig.ApiBase), embedded as assembly metadata: production unless
    -p:PPVPN_API_BASE=... or the environment variable of the same name says otherwise (CI: the
    workflow's api_base). Settings → Developer → API endpoint (shown by the dev switch)
    overrides it at runtime.
  -->
  <PropertyGroup>
    <PPVPN_API_BASE Condition="'$(PPVPN_API_BASE)' == ''">https://www.peakpassvpn.com</PPVPN_API_BASE>
  </PropertyGroup>

  <!--
    Auto-update (WinSparkle). Both values are embedded as assembly metadata;
    when either is empty, updates are disabled and "Check for updates" is
    hidden. There is no default feed: a release build gets its channel's
    (ci-build.ps1), through -p:PPVPN_UPDATE_FEED_URL=... or the environment
    variable of the same name.
  -->

  <ItemGroup>
    <AssemblyMetadata Include="PPVPN.ApiBase" Value="$(PPVPN_API_BASE)" />
    <AssemblyMetadata Include="PPVPN.UpdateFeedUrl" Value="$(PPVPN_UPDATE_FEED_URL)" />
    <AssemblyMetadata Include="PPVPN.UpdatePublicKey" Value="$(PPVPN_UPDATE_PUBLIC_KEY)" />
    <AssemblyMetadata Include="PPVPN.BuildVersion" Value="$(FileVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <!--
      Native updater; runtimes/win-x64/native/WinSparkle.dll lands next to ppvpn.exe.
      Pinned to 0.9.2: 0.9.3 and 0.9.4 no longer load their zh_CN/zh_TW
      translations (German still works), so Chinese Windows would get an
      English update dialog. Re-test Chinese before upgrading. scripts/package.ps1
      takes winsparkle-tool.exe from the same package version.
    -->
    <PackageReference Include="WinSparkle" Version="0.9.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- View models, the fake backend and (transitively) PPVPN.Client: the UniFFI bindings and
         runtimes/win-x64/native/ppvpn_client.dll. Build those first:
         crates\desktop\scripts\build-dotnet.ps1 (see README.md). -->
    <ProjectReference Include="..\..\dotnet-shared\PPVPN.App.Core\PPVPN.App.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.ico;Assets\**\*.png;Assets\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Windows-only UI strings (Strings/Loc.cs); everything else is App.Core's shared catalog. -->
    <EmbeddedResource Include="Strings\strings.windows.json" LogicalName="PPVPN.Windows.Strings.%(Filename)%(Extension)" />
    <None Remove="Strings\*.json" />
    <Content Remove="Strings\*.json" />
  </ItemGroup>
</Project>
