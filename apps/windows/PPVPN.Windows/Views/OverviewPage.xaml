<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PPVPN.Windows.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PPVPN.Windows.Controls"
    xmlns:vm="using:PPVPN.App.Core.ViewModels"
    xmlns:local="using:PPVPN.Windows"
    xmlns:loc="using:PPVPN.Windows.Strings"
    xmlns:views="using:PPVPN.Windows.Views"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Current node combo items: flag 20×14, name, latency 12px. -->
        <DataTemplate x:Key="NodeOptionTemplate" x:DataType="vm:NodeItemViewModel">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="20"
                    Height="14"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource FlagRingBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
                    <Image Source="{x:Bind local:Ui.Flag(CountryCode)}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{x:Bind local:Ui.StatusToneBrush(LatencyTone), Mode=OneWay}"
                    Text="{x:Bind views:OverviewPage.ComboLatency(LatencyKind, LatencyText), Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!-- Anomaly row: tone-soft background, 18 icon, bold title + description, buttons. -->
        <DataTemplate x:Key="NoticeTemplate" x:DataType="vm:ConnectionNotice">
            <Border
                Margin="0,12,0,0"
                Padding="16,12,16,12"
                Background="{x:Bind local:Ui.ToneSoftBrush(Tone)}"
                CornerRadius="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        Margin="0,1,0,0"
                        FontSize="18"
                        Foreground="{x:Bind local:Ui.ToneBrush(Tone)}"
                        Glyph="{x:Bind views:OverviewPage.NoticeGlyph(Tone)}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Command="{x:Bind SecondaryAction}" Content="{x:Bind SecondaryActionText}" Visibility="{x:Bind local:Ui.VisibleText(SecondaryActionText)}" />
                        <Button Command="{x:Bind Action}" Content="{x:Bind ActionText}" Visibility="{x:Bind local:Ui.VisibleText(ActionText)}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Padding" Value="20,14,20,14" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="MinHeight" Value="48" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- The Grid centres the capped column by its real width; directly in the ScrollViewer it was
             centred by its desired width and overflowed the window above ~1008 px. -->
        <Grid>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PageContentPadding}">

                <!-- ① The latest node configuration is invalid; the previous one stays in use. -->
                <InfoBar
                    Title="{loc:S Key=cfgT}"
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ConfigInvalid, Mode=OneWay}"
                    Message="{loc:S Key=cfgD}"
                    Severity="Warning" />

                <!-- Access restricted replaces ②–⑤. -->
                <views:ProfileEmptyState Visibility="{x:Bind ViewModel.IsRestricted, Mode=OneWay}" />

                <StackPanel Visibility="{x:Bind local:Ui.VisibleUnless(ViewModel.IsSignedIn, ViewModel.IsRestricted), Mode=OneWay}">
                    <!-- ② Connection card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <!-- Header: status circle, title, flag · node · detail; the connect switch on the right (§G). -->
                            <Grid Padding="20,20,20,6" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="48"
                                    Height="48"
                                    Background="{x:Bind local:Ui.ToneSoftBrush(ViewModel.ConnectionTone), Mode=OneWay}"
                                    CornerRadius="24">
                                    <FontIcon
                                        x:Name="StatusIcon"
                                        FontSize="26"
                                        Foreground="{x:Bind local:Ui.ToneBrush(ViewModel.ConnectionTone), Mode=OneWay}"
                                        Glyph="{x:Bind views:OverviewPage.Glyph(ViewModel.ConnectState, ViewModel.ConnectionMode), Mode=OneWay}"
                                        RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform x:Name="StatusSpin" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{x:Bind local:Ui.TitleBrush(ViewModel.ConnectionTone), Mode=OneWay}"
                                        Text="{x:Bind ViewModel.ConnectionTitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border
                                            Width="20"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            BorderBrush="{ThemeResource FlagRingBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Visibility="{x:Bind local:Ui.VisibleText(ViewModel.CurrentNodeCountryCode), Mode=OneWay}">
                                            <Image Source="{x:Bind local:Ui.Flag(ViewModel.CurrentNodeCountryCode), Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.CurrentNodeName, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind views:OverviewPage.Detail(ViewModel.ConnectionDetail), Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <controls:StateToggle
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:S Key=connect}"
                                    Command="{x:Bind ViewModel.ToggleConnectCommand}"
                                    IsInteractive="{x:Bind ViewModel.ConnectSwitchEnabled, Mode=OneWay}"
                                    State="{x:Bind ViewModel.ConnectSwitch, Mode=OneWay}" />
                            </Grid>
                            <!-- The connection method, in the weakest text colour. -->
                            <TextBlock
                                Margin="84,0,20,16"
                                Style="{StaticResource RowDescriptionStyle}"
                                Text="{x:Bind ViewModel.ConnectionMethodCaption, Mode=OneWay}" />

                            <!-- The service is not installed yet (enhanced mode). -->
                            <Border
                                Margin="56,0,20,14"
                                Padding="12,10,12,10"
                                Background="{ThemeResource AccentSoftBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind ViewModel.ShowInstallHint, Mode=OneWay}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xEA18;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{loc:S Key=needInstall}"
                                        TextWrapping="Wrap" />
                                    <Button Grid.Column="2" Height="32" Command="{x:Bind ViewModel.InstallServiceCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="14" Glyph="&#xEA18;" />
                                            <TextBlock Text="{loc:S Key=installBtn}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowDividerStyle}" />

                            <Grid Style="{StaticResource RowGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE909;" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{loc:S Key=currentNode}" />
                                <ComboBox
                                    Grid.Column="2"
                                    MinWidth="220"
                                    MaxWidth="360"
                                    AutomationProperties.Name="{loc:S Key=currentNode}"
                                    ItemTemplate="{StaticResource NodeOptionTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Nodes.Items}"
                                    SelectedItem="{x:Bind ViewModel.CurrentNode, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ③ Anomalies -->
                    <ItemsControl ItemTemplate="{StaticResource NoticeTemplate}" ItemsSource="{x:Bind ViewModel.Notices}" />

                    <!-- ④ Live traffic: rates only. -->
                    <TextBlock Margin="1,24,0,8" FontWeight="SemiBold" Text="{loc:S Key=traffic}" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="20,16,20,16" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE74A;" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:S Key=upload}" />
                                </StackPanel>
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{x:Bind ViewModel.UpRate, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="20,16,20,16" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE74B;" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:S Key=download}" />
                                </StackPanel>
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{x:Bind ViewModel.DownRate, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ⑤ Local proxy: the routed user of the shared port (rules / global); a node's own user is on Nodes. -->
                    <Grid Margin="1,24,0,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" Text="{loc:S Key=localProxy}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,1"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.ProxyNote, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Border Padding="0,6,0,6" Style="{StaticResource CardStyle}">
                        <Grid>
                            <TextBlock
                                Margin="20,10,20,10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.ProxyUnavailableText, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Collapsed(ViewModel.HasRoutedProxy), Mode=OneWay}" />
                            <StackPanel Visibility="{x:Bind ViewModel.HasRoutedProxy, Mode=OneWay}">
                                <Grid Padding="20,10,20,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="HTTP" />
                                    <TextBox
                                        Grid.Column="1"
                                        Height="32"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="13"
                                        IsReadOnly="True"
                                        Text="{x:Bind ViewModel.RoutedProxy.HttpDisplay, Mode=OneWay}" />
                                    <controls:CopyButton Grid.Column="2" MinWidth="84" CopyCommand="{x:Bind ViewModel.RoutedProxy.CopyHttpCommand, Mode=OneWay}" />
                                </Grid>
                                <Grid Padding="20,10,20,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="SOCKS5" />
                                    <TextBox
                                        Grid.Column="1"
                                        Height="32"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="13"
                                        IsReadOnly="True"
                                        Text="{x:Bind ViewModel.RoutedProxy.SocksDisplay, Mode=OneWay}" />
                                    <controls:CopyButton Grid.Column="2" MinWidth="84" CopyCommand="{x:Bind ViewModel.RoutedProxy.CopySocksCommand, Mode=OneWay}" />
                                </Grid>
                                <Grid Padding="20,6,20,2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:S Key=user}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.RoutedProxy.Username, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.RoutedProxy.Username, Mode=OneWay}" />
                                    <controls:CopyButton
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="{loc:S Key=copy}"
                                        CopyCommand="{x:Bind ViewModel.RoutedProxy.CopyUsernameCommand, Mode=OneWay}"
                                        IconOnly="True"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{loc:S Key=copy}" />
                                </Grid>
                                <Grid Padding="20,2,20,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{loc:S Key=authPass}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        IsTextSelectionEnabled="{x:Bind ViewModel.RoutedProxy.PasswordRevealed, Mode=OneWay}"
                                        Text="{x:Bind ViewModel.RoutedProxy.PasswordDisplay, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="{x:Bind local:Ui.EyeText(ViewModel.RoutedProxy.PasswordRevealed), Mode=OneWay}"
                                        Command="{x:Bind ViewModel.RoutedProxy.TogglePasswordRevealedCommand, Mode=OneWay}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind local:Ui.EyeText(ViewModel.RoutedProxy.PasswordRevealed), Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="{x:Bind local:Ui.EyeGlyph(ViewModel.RoutedProxy.PasswordRevealed), Mode=OneWay}" />
                                    </Button>
                                    <controls:CopyButton
                                        Grid.Column="3"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="{loc:S Key=copy}"
                                        CopyCommand="{x:Bind ViewModel.RoutedProxy.CopyPasswordCommand, Mode=OneWay}"
                                        IconOnly="True"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{loc:S Key=copy}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
