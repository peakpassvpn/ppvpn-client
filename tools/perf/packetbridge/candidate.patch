+    fn packets(values: &[u8]) -> PacketBatch {
+        let mut batch = PacketBatch::with_limit(values.len().max(1));
+        for &value in values {
+            batch
+                .push(Packet::from_payload(
+                    PacketToken::new(u64::from(value)),
+                    0,
+                    &[value],
+                ))
+                .unwrap();
+        }
+        batch
+    }
