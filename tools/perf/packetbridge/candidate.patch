+            .unwrap_or(2048);
+        assert!(rounds > 0);
+        let (mut bridge, mut flow) = PacketBridge::pair(64).unwrap();
+        let mut recv_calls = 0_u64;
+        let mut send_calls = 0_u64;
+        let mut recv_hist = [0_u64; 65];
+        let mut send_hist = [0_u64; 65];
+        let mut payload_bytes = 0_u64;
+        let mut checksum = 0_u64;
+        let started = std::time::Instant::now();
+        for round in 0..rounds {
+            for index in 0..64 {
+                let value = ((round * 64 + index) % 251) as u8;
+                flow.uplink.send(vec![value; 1400]).await.unwrap();
+            }
+            let mut batch = PacketBatch::with_limit(64);
+            while batch.len() < 64 {
+                let count = bridge.recv(&mut batch).await.unwrap();
+                assert!(count > 0 && count <= 64);
+                recv_hist[count] += 1;
+                recv_calls += 1;
+            }
+            // Drain the real host receiver, including the old implementation's
+            // one-packet sends; the input batch retains the unaccepted suffix.
+            let mut expected = 0;
+            while !batch.is_empty() {
+                let count = bridge.send(&batch).await.unwrap();
+                assert!(count > 0 && count <= batch.len());
+                send_hist[count] += 1;
+                send_calls += 1;
+                batch.acknowledge_sent(count).unwrap();
+                for _ in 0..count {
+                    let packet = flow.downlink.recv().await.expect("host output ended early");
+                    let value = ((round * 64 + expected) % 251) as u8;
+                    assert_eq!(packet.len(), 1400);
+                    assert!(packet.iter().all(|&byte| byte == value));
+                    checksum += packet.iter().map(|&byte| u64::from(byte)).sum::<u64>();
+                    payload_bytes += packet.len() as u64;
+                    expected += 1;
+                }
+            }
+            assert_eq!(expected, 64);
+        }
+        assert_eq!(payload_bytes, rounds as u64 * 64 * 1400);
+        assert!(flow.downlink.rx.is_empty());
+        assert!(bridge.rx.is_empty());
+        println!("PACKET_BRIDGE_BENCH rounds={rounds} packets={} payload_bytes={payload_bytes} checksum={checksum} recv_calls={recv_calls} send_calls={send_calls} recv_batches={recv_hist:?} send_batches={send_hist:?} elapsed_ns={} max_batch={}",
+            rounds * 64, started.elapsed().as_nanos(), bridge.capabilities().max_batch);
+    }
