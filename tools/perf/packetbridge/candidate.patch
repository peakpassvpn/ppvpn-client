+    #[tokio::test]
+    async fn packet_bridge_ready_receive_preserves_prefix_room_and_tokens() {
+        let (mut bridge, flow) = PacketBridge::pair(64).unwrap();
+        for value in 0..64 {
+            flow.uplink.send(vec![value]).await.unwrap();
+        }
+        let mut out = packets(&[99]);
+        // An existing prefix remains intact; only newly appended packets count.
+        assert_eq!(
+            bridge.recv(&mut out).await.unwrap_err().kind(),
+            io::ErrorKind::InvalidInput
+        );
+        let mut out = PacketBatch::with_limit(4);
+        out.push(Packet::from_payload(PacketToken::new(999), 0, &[99]))
+            .unwrap();
+        assert_eq!(bridge.recv(&mut out).await.unwrap(), 3);
+        assert_eq!(out.pop_front().unwrap().token().get(), 999);
+        for value in 0..3 {
+            let packet = out.pop_front().unwrap();
+            assert_eq!(packet.token().get(), value);
+            assert_eq!(packet.payload(), &[value as u8]);
+        }
+        let mut rest = PacketBatch::with_limit(128);
+        assert_eq!(bridge.recv(&mut rest).await.unwrap(), 61);
+        for value in 3..64 {
+            assert_eq!(rest.pop_front().unwrap().token().get(), value);
+        }
