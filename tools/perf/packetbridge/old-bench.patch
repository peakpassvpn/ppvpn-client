+    /// The real runner consumes PacketBridge packets and emits UDP replies.
+    /// This exercises runner RX batching and accepted-prefix TX, not the
+    /// dispatcher, TCP congestion control, relay, or an iOS packetFlow device.
+    #[tokio::test]
+    #[ignore = "managed real PacketBridge/SingleShardRunner old/new measurement"]
+    async fn packet_bridge_runner_loopbench() {
+        use sail_netstack::{
+            emit_udp_packet, parse_ip_packet, parse_udp_datagram, BudgetProfile, ResourceLedger,
+            RunnerConfig, SingleShardRunner,
+        };
+        use std::net::{Ipv4Addr, SocketAddr};
+        use std::sync::Arc;
+        use std::time::Duration;
+
+        let rounds = std::env::var("SAIL_PACKET_BRIDGE_BENCH_ROUNDS")
+            .ok()
+            .map(|value| value.parse::<usize>().expect("positive round count"))
+            .unwrap_or(2048);
+        assert!(rounds > 0);
+        let (bridge, mut flow) = PacketBridge::pair(64).unwrap();
+        let ledger = ResourceLedger::new(BudgetProfile::Mobile.budget()).unwrap();
+        let mut config = RunnerConfig::default();
+        config.packets_per_step = 16; // The real TUN adapter's existing setting.
+        let mut runner = SingleShardRunner::new(bridge, Arc::clone(&ledger), config).unwrap();
+        let source = SocketAddr::from((Ipv4Addr::new(192, 0, 2, 1), 40000));
+        let destination = SocketAddr::from((Ipv4Addr::new(198, 51, 100, 2), 9000));
+        let mut payload_bytes = 0_u64;
+        let mut checksum = 0_u64;
+        let mut steps = 0_u64;
+        let mut peak_ledger_bytes = 0;
+        let started = std::time::Instant::now();
+        let run_deadline = tokio::time::Instant::now() + Duration::from_secs(60);
+        for round in 0..rounds {
+            let now = round as u64;
+            for index in 0..64 {
+                let value = ((round * 64 + index) % 251) as u8;
+                let wire =
+                    emit_udp_packet(source, destination, &vec![value; 1400], 64, index as u16)
+                        .unwrap();
+                flow.uplink.send(wire).await.unwrap();
+            }
+            let mut received = 0;
+            let mut output = Vec::with_capacity(64);
+            let deadline =
+                (tokio::time::Instant::now() + Duration::from_secs(10)).min(run_deadline);
+            let mut round_steps = 0;
+            if round == 0 {
+                eprintln!(
+                    "PACKET_BRIDGE_RUNNER_PHASE first_rx_start stats={:?}",
+                    runner.stats_snapshot()
+                );
+            }
+            while received < 64 {
+                assert!(round_steps < 512 && tokio::time::Instant::now() < deadline,
+                    "RX progress bound: round={round} received={received} pending_rx={} pending_tx={} stats={:?}",
+                    runner.pending_rx(), runner.pending_tx(), runner.stats_snapshot());
+                let outcome = tokio::time::timeout_at(deadline, runner.step(now))
+                    .await.unwrap_or_else(|_| panic!(
+                        "RX deadline: round={round} received={received} pending_rx={} pending_tx={} stats={:?}",
+                        runner.pending_rx(), runner.pending_tx(), runner.stats_snapshot()))
+                    .unwrap();
+                round_steps += 1;
+                if round == 0 && round_steps == 1 {
+                    eprintln!("PACKET_BRIDGE_RUNNER_PHASE first_rx_done received={} processed={} datagrams={} pending_rx={} pending_tx={} stats={:?}",
+                        outcome.received_packets, outcome.processed_packets, outcome.datagrams.len(),
+                        runner.pending_rx(), runner.pending_tx(), runner.stats_snapshot());
+                }
+                steps += 1;
+                received += outcome.datagrams.len();
+                for datagram in outcome.datagrams {
+                    runner
+                        .queue_udp_reply(
+                            datagram.token,
+                            datagram.destination,
+                            &datagram.payload.to_vec(),
+                            now,
+                        )
+                        .unwrap();
+                }
+                peak_ledger_bytes = peak_ledger_bytes.max(ledger.snapshot().total_bytes);
+                while let Ok(wire) = flow.downlink.rx.try_recv() {
+                    assert!(output.len() < 64, "unexpected extra runner output");
+                    output.push(wire);
+                }
+                // A ready empty outcome must not turn into a cooperative
+                // budget-starving loop; the step/wall bounds retain failures.
+                tokio::task::yield_now().await;
+            }
+            assert_eq!(received, 64);
+            if round == 0 {
+                eprintln!("PACKET_BRIDGE_RUNNER_PHASE first_tx_start elapsed_ns={} ledger_bytes={} host_packets={} pending_rx={} pending_tx={} stats={:?}",
+                    started.elapsed().as_nanos(), ledger.snapshot().total_bytes,
+                    output.len(), runner.pending_rx(), runner.pending_tx(), runner.stats_snapshot());
+            }
+            while runner.pending_tx() > 0 {
+                assert!(round_steps < 512 && tokio::time::Instant::now() < deadline,
+                    "TX progress bound: round={round} received={received} host_packets={} pending_rx={} pending_tx={} stats={:?}",
+                    output.len(), runner.pending_rx(), runner.pending_tx(), runner.stats_snapshot());
+
+                // step can finish flushing then await a new ingress packet.
+                // Cancelling that await is the adapter's real timer/command
+                // contract; accepted output is accounted in runner counters.
+                {
+                    let step = runner.step(now);
+                    tokio::pin!(step);
+                    if let std::task::Poll::Ready(result) = futures::poll!(&mut step) {
+                        result.unwrap();
+                    }
+                }
+                steps += 1;
+                round_steps += 1;
+                while let Ok(wire) = flow.downlink.rx.try_recv() {
+                    assert!(output.len() < 64, "unexpected extra runner output");
+                    output.push(wire);
+                }
+                // A reserve can be Pending with capacity available because
+                // Tokio's task budget is exhausted. Dropping and repolling
+                // without yielding cannot replenish that budget.
+                tokio::task::yield_now().await;
+            }
+            peak_ledger_bytes = peak_ledger_bytes.max(ledger.snapshot().total_bytes);
+            while output.len() < 64 {
+                let wire = tokio::time::timeout_at(deadline, flow.downlink.recv())
+                    .await
+                    .expect("runner output deadline")
+                    .expect("host output ended early");
+                output.push(wire);
+            }
+            for (index, wire) in output.iter().enumerate() {
+                let ip = parse_ip_packet(&wire, true).unwrap();
+                let datagram = parse_udp_datagram(ip, true).unwrap();
+                let value = ((round * 64 + index) % 251) as u8;
+                assert_eq!(datagram.payload.len(), 1400);
+                assert!(datagram.payload.iter().all(|&byte| byte == value));
+                payload_bytes += datagram.payload.len() as u64;
+                checksum += datagram
+                    .payload
+                    .iter()
+                    .map(|&byte| u64::from(byte))
+                    .sum::<u64>();
+            }
+            assert!(flow.downlink.rx.is_empty());
+            if round == 0 {
+                eprintln!("PACKET_BRIDGE_RUNNER_PHASE first_round_done round_steps={round_steps} pending_rx={} pending_tx={} stats={:?}",
+                    runner.pending_rx(), runner.pending_tx(), runner.stats_snapshot());
+            }
+        }
+        let stats = runner.stats_snapshot();
+        assert_eq!(stats.rx_packets, rounds as u64 * 64);
+        assert_eq!(stats.tx_packets, rounds as u64 * 64);
+        assert_eq!(stats.dropped_packets, 0);
+        assert_eq!(stats.runner_failures, 0);
+        assert_eq!(payload_bytes, rounds as u64 * 64 * 1400);
+        println!("PACKET_BRIDGE_RUNNER_BENCH rounds={rounds} payload_bytes={payload_bytes} checksum={checksum} steps={steps} elapsed_ns={} ledger_peak_sampled_bytes={peak_ledger_bytes} stats={stats:?}", started.elapsed().as_nanos());
+        runner.abort();
+        drop(runner);
+        assert_eq!(ledger.snapshot().total_bytes, 0);
+        assert!(flow.downlink.recv().await.is_none());
+    }
