+    #[tokio::test]
+    async fn packet_bridge_runner_resumes_after_cooperative_budget_exhaustion() {
+        use sail_netstack::{
+            emit_udp_packet, BudgetProfile, ResourceLedger, RunnerConfig, SingleShardRunner,
+        };
+        use std::net::{Ipv4Addr, SocketAddr};
+        use std::sync::Arc;
+        use std::time::Duration;
+
+        let (bridge, mut flow) = PacketBridge::pair(64).unwrap();
+        let ledger = ResourceLedger::new(BudgetProfile::Mobile.budget()).unwrap();
+        let mut runner =
+            SingleShardRunner::new(bridge, Arc::clone(&ledger), RunnerConfig::default()).unwrap();
+        let source = SocketAddr::from((Ipv4Addr::new(192, 0, 2, 1), 40000));
+        let destination = SocketAddr::from((Ipv4Addr::new(198, 51, 100, 2), 9000));
+        flow.uplink
+            .send(emit_udp_packet(source, destination, b"budget", 64, 0).unwrap())
+            .await
+            .unwrap();
+        let input = tokio::time::timeout(Duration::from_secs(2), runner.step(0))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(input.datagrams.len(), 1);
+        let datagram = &input.datagrams[0];
+        runner
+            .queue_udp_reply(datagram.token, datagram.destination, b"budget", 0)
+            .unwrap();
+        drop(input);
+        {
+            let exhaust = async {
+                for _ in 0..1024 {
+                    tokio::task::consume_budget().await;
+                }
+            };
+            tokio::pin!(exhaust);
+            assert!(futures::poll!(&mut exhaust).is_pending());
+        }
+        {
+            let step = runner.step(0);
+            tokio::pin!(step);
+            assert!(futures::poll!(&mut step).is_pending());
+        }
+        assert_eq!(runner.pending_tx(), 1);
+        assert_eq!(runner.stats_snapshot().tx_packets, 0);
+        assert!(flow.downlink.rx.is_empty());
+        // The removed bench loop would retry immediately here forever.
+        // This bounded retry returns control to the executor before polling.
+        for _ in 0..8 {
+            tokio::task::yield_now().await;
+            {
+                let step = runner.step(0);
+                tokio::pin!(step);
+                if let std::task::Poll::Ready(result) = futures::poll!(&mut step) {
+                    result.unwrap();
+                }
+            }
+            if runner.pending_tx() == 0 {
+                break;
+            }
+        }
+        assert_eq!(runner.pending_tx(), 0);
+        assert_eq!(runner.stats_snapshot().tx_packets, 1);
+        assert!(flow.downlink.recv().await.is_some());
+        assert!(flow.downlink.rx.is_empty());
+        runner.abort();
+        drop(runner);
+        assert_eq!(ledger.snapshot().total_bytes, 0);
+    }
