--- a/Sparkle/SPUStandardUserDriver.m
+++ b/Sparkle/SPUStandardUserDriver.m
@@ -43,0 +44,6 @@ - (void)activate;
+// PPVPN's host supplies a read-only, show-time fullscreen decision. The
+// standard user driver, windows, download and installer remain unchanged.
+@protocol PPVPNUpdatePromptDeferral <NSObject>
+- (BOOL)ppvpnShouldDeferUpdatePrompt;
+@end
+
@@ -84,0 +91,2 @@ @implementation SPUStandardUserDriver
+    NSUInteger _ppvpnPresentationGeneration;
+    NSUInteger _ppvpnCheckingGeneration;
@@ -111,0 +120,17 @@ - (instancetype)initWithHostBundle:(NSBundle *)hostBundle delegate:(nullable id<
+// A runtime marker lets the host refuse an accidentally unpatched framework.
++ (BOOL)ppvpnHasPreShowGate { return YES; }
+
+- (BOOL)ppvpnDeferPresentation:(void (^)(SPUStandardUserDriver *))action SPU_OBJC_DIRECT
+{
+    id<PPVPNUpdatePromptDeferral> delegate = (id)_delegate;
+    if (![delegate respondsToSelector:@selector(ppvpnShouldDeferUpdatePrompt)] ||
+        ![delegate ppvpnShouldDeferUpdatePrompt]) return NO;
+    NSUInteger generation = _ppvpnPresentationGeneration;
+    __weak __typeof__(self) weakSelf = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        __typeof__(self) strongSelf = weakSelf;
+        if (strongSelf != nil && strongSelf->_ppvpnPresentationGeneration == generation) action(strongSelf);
+    });
+    return YES;
+}
