@@ -1279,0 +1288,17 @@ void App::ShowWindow()
+    // Recheck on the UI thread after the network response and every deferred
+    // retry. A later silent-update decision cancels an in-flight fallback.
+    bool checks = false;
+    Settings::ReadConfigValue("CheckForUpdates", checks, false);
+    if (m_scheduled && !checks)
+    {
+        m_showTimer.Stop();
+        m_win->Destroy();
+        m_win = NULL;
+        return;
+    }
+    if (ppvpn_update::foreground_fullscreen())
+    {
+        m_showTimer.StartOnce(1000);
+        return;
+    }
+    m_showTimer.Stop();
@@ -1282,0 +1308,8 @@ void App::ShowWindow()
+    // Centering/layout must not turn a check-time decision into a show-time
+    // race. Never Show/Raise then hide an already activated update window.
+    if (ppvpn_update::foreground_fullscreen())
+    {
+        m_win->Thaw();
+        m_showTimer.StartOnce(1000);
+        return;
+    }
@@ -1285 +1318,14 @@ void App::ShowWindow()
