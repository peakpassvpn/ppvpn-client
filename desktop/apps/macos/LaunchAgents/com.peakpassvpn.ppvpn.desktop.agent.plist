<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The push agent's launchd job, registered by the app through
     SMAppService.agent (PushAgentService). Restarted unless it exits cleanly. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.peakpassvpn.ppvpn.desktop.agent</string>
    <key>BundleProgram</key>
    <string>Contents/Library/LoginItems/PPVPN Agent.app/Contents/MacOS/PPVPN Agent</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.peakpassvpn.ppvpn.desktop</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
