<Project Sdk="Microsoft.NET.Sdk">
  <!--
    C# bindings for the shared ppvpn-client Rust crate (UniFFI).
    Generated/ and runtimes/ are produced by crates/ppvpn-client/scripts/build-dotnet.{sh,ps1};
    see README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated bindings use unsafe pointers and [LibraryImport]. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PPVPN.Client</RootNamespace>
    <AssemblyName>PPVPN.Client</AssemblyName>
    <PackageId>PPVPN.Client</PackageId>
    <IsPackable>true</IsPackable>
    <!-- Generated/ppvpn_client.cs opts into #nullable itself and trips these; CS1998 is async
         without await. CA2255: [ModuleInitializer] in a library is intentional (NativeLoader.cs). -->
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8600;CS8601;CS8602;CS8603;CS8604;CS1998;CA2255</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Generated/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <!--
    Native library, one folder per RID: runtimes/<rid>/native/{libppvpn_client.so,ppvpn_client.dll}.
    * ProjectReference: copied to the consumer's output (and publish) dir under the same
      runtimes/<rid>/native/ path; NativeLoader.cs loads the one matching the
      running OS/arch (falling back to the default probing, e.g. a copy next to the app).
    * NuGet pack: placed at runtimes/<rid>/native/ so NuGet's RID-aware asset
      selection (deps.json) applies.
    %(RecursiveDir) is "<rid>/native/" (everything from the first wildcard on), and pack
    appends it to PackagePath itself.
  -->
  <ItemGroup>
    <None Include="runtimes/*/native/*"
          Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Pack="true"
          PackagePath="runtimes/" />
  </ItemGroup>

  <Target Name="PPVPNClientCheckGenerated" BeforeTargets="CoreCompile"
          Condition="!Exists('$(MSBuildProjectDirectory)/Generated/ppvpn_client.cs')">
    <Error Text="Generated/ppvpn_client.cs is missing. Run crates/ppvpn-client/scripts/build-dotnet.sh (Linux) or build-dotnet.ps1 (Windows) first; see apps/shared/PPVPN.Client/README.md." />
  </Target>
</Project>
