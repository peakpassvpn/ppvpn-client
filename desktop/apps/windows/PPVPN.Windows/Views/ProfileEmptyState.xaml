<?xml version="1.0" encoding="utf-8"?>
<!--
  Access restricted (no subscription, expired, team disabled): one card replacing the overview's
  connection, traffic and proxy blocks, and the node table. Padding 56 × 32: 48 icon, 20 Semibold
  title, description (max 400), buy ↗ + refresh, or switch team ▾ (opens the account menu).
-->
<UserControl
    x:Class="PPVPN.Windows.Views.ProfileEmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PPVPN.Windows"
    xmlns:loc="using:PPVPN.Windows.Strings"
    xmlns:views="using:PPVPN.Windows.Views">
    <Border Padding="32,56,32,56" Style="{StaticResource CardStyle}">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
            <FontIcon
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{x:Bind views:ProfileEmptyStateText.Glyph(ViewModel.Access), Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.RestrictedTitle, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                MaxWidth="400"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.RestrictedMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.OpenPurchaseCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanBuy, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:S Key=buy}" />
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="SwitchTeamButton"
                    Click="OnSwitchTeam"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind local:Ui.Visible(ViewModel.CanSwitchTeam), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:S Key=switchTeam}" />
                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RefreshAccessCommand}" Visibility="{x:Bind local:Ui.Collapsed(ViewModel.CanSwitchTeam), Mode=OneWay}">
                    <TextBlock Text="{x:Bind views:ProfileEmptyStateText.Refresh(ViewModel.IsRefreshingAccess), Mode=OneWay}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
